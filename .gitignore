# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/

# 스냅샷 파이프라인 백업 산출물
data/*.json.bak

# 지도 해안선 생성용 원천 (scripts/build_korea_outline.py가 필요 시 내려받는다)
data/raw/ne_*.geojson

# 철로 선형 파이프라인 원천 캐시 (scripts/build_rail_geometry.py)
data/raw/osm-*.json
